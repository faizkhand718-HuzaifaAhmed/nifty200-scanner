# ==============================================================================
# NIFTY 200 Opportunity Scanner - environment variable template
# ==============================================================================
# Copy this file to .env and fill in REAL values there. .env must never be
# committed to version control (it's in .gitignore) - this file (.env.example)
# is the only one that belongs in git, and it must never contain a real
# secret. Every value below is a placeholder.
#
# In production, prefer a real secrets manager (AWS Secrets Manager, GCP
# Secret Manager, HashiCorp Vault, Doppler, etc.) over a .env file on disk -
# see deploy/DEPLOYMENT.md's "Secret management" section for how to wire one
# in without changing any application code (Settings.from_env() just reads
# os.environ either way; how those variables get INTO the environment is the
# orchestrator's job, not this app's).
# ==============================================================================

# --- Environment identity ---
ENVIRONMENT=development          # development | staging | production
APP_VERSION=0.1.0

# --- Database ---
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# NEVER put a real password directly in this file - see Secret management above.
DATABASE_URL=postgresql+psycopg2://scanner_user:CHANGE_ME@localhost:5432/nifty200_scanner
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Redis (optional; used for multi-instance rate limiting - see
# app/core/rate_limiter.py's module docstring for the single-instance
# in-memory fallback used when this is unset) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # "json" in staging/production, "text" is fine for local dev

# --- Error monitoring (optional - leave SENTRY_DSN unset to disable
# entirely; the app runs correctly either way, see
# app/core/error_monitoring.py) ---
SENTRY_DSN=
ERROR_MONITORING_SAMPLE_RATE=1.0

# --- CORS / security ---
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com
FORCE_HTTPS=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_RANDOM_VALUE

# --- Rate limiting (this app's own API; distinct from the outbound
# provider rate limiting Phase 3 already handles) ---
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=20

# --- LIVE TRADING - disabled by default. Do not flip this to true
# without reading deploy/DEPLOYMENT.md's live-trading section in full. ---
LIVE_TRADING_ENABLED=false
# Only relevant if LIVE_TRADING_ENABLED=true. Matches the prefix your real
# broker adapter's credentials use - e.g. "ZERODHA" reads ZERODHA_API_KEY,
# ZERODHA_API_SECRET, ZERODHA_ACCESS_TOKEN (see
# app/brokers/models.py's BrokerCredentials.from_env()).
BROKER_CREDENTIALS_PREFIX=
# The actual broker credentials themselves - set these directly in your
# secrets manager / orchestrator, NOT in a checked-in .env file. Shown
# here only so their exact names are documented in one place.
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# ZERODHA_ACCESS_TOKEN=

# --- Health checks ---
HEALTH_CHECK_TIMEOUT_SECONDS=5.0

# --- Frontend (separate process/container; see frontend/README.md) ---
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example.com
# NEXT_PUBLIC_WS_URL=wss://api.your-domain.example.com/ws

# --- Market data provider ---
# "mock" (default, safe) or "nse_mcp" (official NSE MCP services -
# https://www.nseindia.com/nse-mcp - see
# app/market_data/providers/nse_mcp_provider.py for exactly what these
# two services do and don't support). NSE's documented client config
# shows NO auth requirement for these endpoints - NSE_MCP_AUTH_TOKEN
# below is a defensive placeholder only, in case that changes; leave it
# unset unless NSE actually requires one.
MARKET_DATA_PROVIDER=mock
NSE_MCP_BHAVCOPY_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_MCP_CMMKT_URL=https://mcp.nseindia.in/cmmkt/mcp
NSE_MCP_AUTH_TOKEN=
NSE_MCP_LIVE_CACHE_TTL_SECONDS=60
NSE_MCP_HISTORICAL_CACHE_TTL_SECONDS=21600
